{
  "name": "dsh-tmon",
  "version": "0.2.0",
  "description": "Brings tmon's long-command workbench into the Harness: a 「命令终端」conversation tab embeds tmon's own web page, and a `tmon_tasks` tool reports each task's status, silence, elapsed time and last progress so the model can tell a stuck command from a slow one. Requires `npm install -g @qiu745/tmon`.",
  "type": "module",
  "license": "MIT",
  "author": "wr0ld",
  "homepage": "https://github.com/wr0ld/dsh-tmon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wr0ld/dsh-tmon.git"
  },
  "bugs": {
    "url": "https://github.com/wr0ld/dsh-tmon/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tmon",
    "terminal",
    "monitor",
    "long-running",
    "ai-agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "skill.md",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
